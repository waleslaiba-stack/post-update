# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram User ID (get from @userinfobot)
ADMIN_ID=your_admin_telegram_user_id_here

# Optional: Residential/Datacenter proxy URL
# Format: http://user:pass@host:port  OR  socks5://user:pass@host:port
PROXY_URL=

# Database file path (default: ./data/fb_monitor.db)
DB_PATH=./data/fb_monitor.db

# Default timezone (default: Asia/Dhaka)
DEFAULT_TIMEZONE=Asia/Dhaka

# Check interval in seconds (default: 50)
CHECK_INTERVAL=50

# Playwright browser timeout in ms (default: 30000)
BROWSER_TIMEOUT=30000
