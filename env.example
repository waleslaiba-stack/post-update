# --- Telegram ---
BOT_TOKEN=123456789:AAExampleTelegramBotTokenGoesHere
ADMIN_ID=123456789

# --- Facebook Graph API ---
# Long-lived User or Page access token for the content YOU own.
# Get one at https://developers.facebook.com/tools/explorer/
# and exchange it for a long-lived token before deploying.
FB_ACCESS_TOKEN=EAAG...your_long_lived_token...
GRAPH_API_VERSION=v19.0

# --- App behavior ---
DB_PATH=bot.db
CHECK_INTERVAL_SECONDS=60
DEFAULT_TIMEZONE=Asia/Dhaka
